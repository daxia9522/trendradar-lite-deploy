# Deployment mode
TZ=Asia/Shanghai
STORAGE_BACKEND=local
AI_ANALYSIS_ENABLED=false

# Schedule (local time in TZ)
CRAWLER_MINUTE=5
MORNING_PUSH_TIME=07:00
NOON_PUSH_TIME=12:00
EVENING_PUSH_TIME=18:00
DAILY_SUMMARY_TIME=22:00
WEEKLY_HOUR=12
WEEKLY_MINUTE=30

# AI provider (LiteLLM provider/model format)
AI_MODEL=
AI_API_KEY=
AI_API_BASE=
AI_FALLBACK_MODELS=
AI_TIMEOUT=240

# SMTP
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=465

# R2/S3 (required by the GitHub Actions deployment)
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto

# Optional NewsNow overrides
PLATFORMS_API_URL=
PLATFORMS_API_FALLBACK_URLS=
