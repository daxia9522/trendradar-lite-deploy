# Deployment mode
TZ=Asia/Shanghai
STORAGE_BACKEND=local
AI_ANALYSIS_ENABLED=false
# 独立分类开关，默认关闭；模型选择由 tasks.ai_filter 配置。
AI_FILTER_ENABLED=false
# Schedule (local time in TZ)
CRAWLER_MINUTE=5
MORNING_PUSH_TIME=07:00
NOON_PUSH_TIME=12:00
EVENING_PUSH_TIME=18:00
DAILY_SUMMARY_TIME=22:00
WEEKLY_WEEKDAY=6
WEEKLY_HOUR=12
WEEKLY_MINUTE=30

# AI group connection variables; never commit real keys or private endpoints.
# model_groups.<group>.api_key_env references one of these names.
# Models/connection references live in model_groups; each task owns model_chain, timeout,
# retry and node request_params in config/config.yaml (or CONFIG_PATH).
GEMINI_API_KEY=
CF_API_KEY=
# model_groups.cf.api_base_env references this name; supply your full endpoint.
CF_API_BASE=
# Native optional file mode: set the path and replace the group's api_key_env
# with api_key_file_env: GEMINI_API_KEY_FILE (or CF_API_KEY_FILE).
# The runtime safely reads a private regular file; setup never opens it.
# GEMINI_API_KEY_FILE=
# CF_API_KEY_FILE=
# SMTP
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=

# R2/S3 (required by remote primary storage, including Actions)
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto

# Optional NewsNow overrides
PLATFORMS_API_URL=
PLATFORMS_API_FALLBACK_URLS=
