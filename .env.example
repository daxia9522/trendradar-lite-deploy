# Deployment mode
TZ=Asia/Shanghai
STORAGE_BACKEND=local
AI_ANALYSIS_ENABLED=false
# Unset: compose uses the latest published multi-architecture image.
# Explicit updates pull the selected tag; existing overrides stay in effect.
#TREND_RADAR_IMAGE=ghcr.io/daxia9522/trendradar-lite-deploy:latest
# install/update --build switches official latest or a digest to :local,
# saving the choice only after successful configuration. Custom tags are kept.
#TREND_RADAR_IMAGE=trendradar-lite-deploy:local

# Schedule (local time in TZ)
CRAWLER_MINUTE=5
MORNING_PUSH_TIME=07:00
NOON_PUSH_TIME=12:00
EVENING_PUSH_TIME=18:00
DAILY_SUMMARY_TIME=22:00
WEEKLY_WEEKDAY=6
WEEKLY_HOUR=12
WEEKLY_MINUTE=30

# AI provider (LiteLLM provider/model format)
AI_MODEL=
AI_API_KEY=
AI_API_KEY_FILE=
AI_API_BASE=
# Ordered fallback models: English commas, no empty models; first slot = weekly keywords.
AI_FALLBACK_MODELS=
# URL and Key columns: @-separated, exactly N slots for N fallback models.
# Preserve leading/trailing/consecutive @; @url = [empty,url], @ = [empty,empty].
AI_FALLBACK_API_BASE=
# Secret list: env/Actions Secrets only; no YAML key or new *_FILE support.
AI_FALLBACK_API_KEY=
# One positional contract even when both columns are blank: each expands to N empty slots.
# A custom primary relay is never inherited by an empty fallback URL; repeat it explicitly.
# Gemini/OpenAI official defaults are pinned; other providers need an explicit URL.
# Empty URL slot = provider official default, never an inherited custom relay.
# Empty Key inherits the primary Key only for the same provider AND effective endpoint.
# Different URLs need explicit Keys even for the same provider; no fallback-to-fallback inheritance.
# @ inside a single URL/Key is unsupported (no escaping); models such as openai/@cf/... are OK.
# URLs must be HTTP(S) without embedded user:password. Same-model slots are not deduplicated.
# Synthetic examples only: replace models/endpoints/keys before use.
# Two official Gemini models share only the primary Key (no new columns needed):
# AI_MODEL=gemini/gemini-3.5-flash
# AI_API_BASE=
# AI_API_KEY=synthetic-gemini-key
# AI_FALLBACK_MODELS=gemini/gemini-3.5-flash-lite
# AI_FALLBACK_API_BASE=
# AI_FALLBACK_API_KEY=
# Three OpenAI-compatible endpoints with independent Keys:
# AI_MODEL=openai/primary-model
# AI_API_BASE=https://primary.example.invalid/v1
# AI_API_KEY=synthetic-primary-key
# AI_FALLBACK_MODELS=openai/fallback-model-a,openai/fallback-model-b
# AI_FALLBACK_API_BASE=https://backup-a.example.invalid/v1@https://backup-b.example.invalid/v1
# AI_FALLBACK_API_KEY=synthetic-backup-a-key@synthetic-backup-b-key
# Shared by daily/weekly reports and weekly keywords (seconds).
AI_TIMEOUT=120

# SMTP
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=

# Optional nightly backup of local news/rss SQLite databases (off by default).
# Uses TZ/TIMEZONE. Enabling requires STORAGE_BACKEND=local and the S3 fields below.
R2_BACKUP_ENABLED=false
R2_BACKUP_TIME=23:40
R2_BACKUP_LOOKBACK_DAYS=2

# R2/S3 (required by Actions, or when local nightly backup is enabled)
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto

# Optional NewsNow overrides
PLATFORMS_API_URL=
PLATFORMS_API_FALLBACK_URLS=
