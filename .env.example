# Deployment mode
TZ=Asia/Shanghai
STORAGE_BACKEND=local
AI_ANALYSIS_ENABLED=false
# Unset: compose uses the verified v26.10 multi-architecture OCI index digest.
# Tags (including version tags) can move; only a digest fixes image contents.
# Explicit install/update --build switches a digest to :local and saves that
# choice only after successful configuration. To use a custom build tag:
#TREND_RADAR_IMAGE=trendradar-lite-deploy:local

# Schedule (local time in TZ)
CRAWLER_MINUTE=5
MORNING_PUSH_TIME=07:00
NOON_PUSH_TIME=12:00
EVENING_PUSH_TIME=18:00
DAILY_SUMMARY_TIME=22:00
WEEKLY_WEEKDAY=6
WEEKLY_HOUR=12
WEEKLY_MINUTE=30

# AI provider (LiteLLM provider/model format)
AI_MODEL=
AI_API_KEY=
AI_API_KEY_FILE=
AI_API_BASE=
AI_FALLBACK_MODELS=
AI_TIMEOUT=120

# SMTP
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=

# Optional nightly backup of local news/rss SQLite databases (off by default).
# Uses TZ/TIMEZONE. Enabling requires STORAGE_BACKEND=local and the S3 fields below.
R2_BACKUP_ENABLED=false
R2_BACKUP_TIME=23:40
R2_BACKUP_LOOKBACK_DAYS=2

# R2/S3 (required by Actions, or when local nightly backup is enabled)
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto

# Optional NewsNow overrides
PLATFORMS_API_URL=
PLATFORMS_API_FALLBACK_URLS=
